{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["gru1"],
  "functions": {
    "src/app/api/properties/import-airbnb/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/properties/[id]/sync-calendar/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/chat/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/whatsapp/lines/[id]/backfill/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
